<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:vc="http://www.w3.org/2007/XMLSchema-versioning" xmlns:fgistp="https://fgistp.economy.gov.ru/" targetNamespace="https://fgistp.economy.gov.ru/" elementFormDefault="qualified" attributeFormDefault="unqualified">

	<!--

	По каждому классу объектов задаётся ОДИН показатель НГП
	ZNP_TYPE — минимальное нормативное количество объектов
	подкласса CLASSID на территории OKTMO.

	Каждая XML-запись описывает: «на территории OKTMO для подкласса CLASSID класса <Class>
	установлен норматив минимального количества объектов ZNP_TYPE».

	УРОВНИ НОРМИРОВАНИЯ (региональный / муниципальный)
	====================================================================

	Схема НЕ разделяет классы объектов по уровню нормирования —
	уровень определяется длиной и структурой кода ОКТМО:
	  - 8 знаков, последние 6 нулей (например 14000000)
	    — субъект РФ целиком (региональный уровень);
	  - 8 знаков с непустыми позициями 3-8 (например 14701000)
	    — городской округ / муниципальный район;
	  - 11 знаков (например 35729000156)
	    — конкретный населённый пункт.

	Корректность отнесения объекта к региональному или муниципальному
	уровню (РНГП vs МНГП) определяется внешними нормативами
	(Градостроительный кодекс РФ ст. 29.2 и 29.4, методические указания
	Минэкономразвития) и в XSD не закодирована.
	====================================================================
	-->

	<!-- ================================================================
	     Общие типы
	     ================================================================ -->

	<xs:simpleType name="UUID">
		<xs:annotation>
			<xs:documentation>Глобальный идентификатор записи показателя НГП (UUID v4). Одна запись = один показатель обеспеченности на территории OKTMO по подклассу CLASSID.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:pattern value="(urn:uuid:)?[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}|\{[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}\}"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="OKTMO">
		<xs:annotation>
			<xs:documentation>Код из Общероссийского классификатора территорий муниципальных образований (8 или 11 знаков)</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:minLength value="8"/>
			<xs:maxLength value="11"/>
			<xs:pattern value="[0-9]{8}"/>
			<xs:pattern value="[0-9]{11}"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="ZNP_TYPE" fgistp:username="Значение показателя НГП (минимальное количество объектов)">
		<xs:annotation>
			<xs:documentation>Минимальное нормативное количество объектов подкласса CLASSID, требуемое на территории OKTMO (уровень субъекта РФ для РНГП / муниципального образования для МНГП). Целое неотрицательное; 0 означает «норматив не установлен».</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:nonNegativeInteger"/>
	</xs:simpleType>

	<xs:simpleType name="MaxAccess" fgistp:username="Максимальная пешеходная доступность"><xs:annotation><xs:documentation>Максимальная (нормативная) пешеходная доступность объекта, метры (минуты). Опциональный показатель.</xs:documentation></xs:annotation><xs:restriction base="xs:positiveInteger"/></xs:simpleType><xs:simpleType name="TransAccess" fgistp:username="Транспортная доступность, мин"><xs:annotation><xs:documentation>Максимальная (нормативная) транспортная доступность объекта, минуты. Опциональный показатель.</xs:documentation></xs:annotation><xs:restriction base="xs:positiveInteger"/></xs:simpleType><xs:simpleType name="LandPlot" fgistp:username="Размер земельного участка"><xs:annotation><xs:documentation>Размер земельного участка объекта, м² на 1 место/единицу. Опциональный показатель.</xs:documentation></xs:annotation><xs:restriction base="xs:positiveInteger"/></xs:simpleType><!-- ================================================================
